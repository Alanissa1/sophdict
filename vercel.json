{
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/feedbackandsupport",
      "destination": "/api/feedback"
    },
    {
      "source": "/((?!api|js|css|SophDict|Merriam|manifest|robots.txt|index.html|favicon|.*\\.).*)",
      "destination": "/api/render"
    }
  ],
  "headers": [
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/api/(dictionary|thesaurus|translate|suggestions|sentence)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=31536000, stale-while-revalidate=604800, immutable"
        },
        {
          "key": "Vary",
          "value": "sec-fetch-site, sec-fetch-mode"
        }
      ]
    }
  ]
}
